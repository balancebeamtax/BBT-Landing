# --- balancebeamteam.com landing page env ---

# GHL inbound webhook for /extension-cleanup-review form submissions.
# Production: paste the production webhook URL after building the new workflow per
# extension-cleanup-workflow-build-spec.md (Section J).
# Preview: paste the SANDBOX webhook URL so preview deploys don't pollute production data.
NEXT_PUBLIC_GHL_TEAM_EXTENSION_CLEANUP_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/PLACEHOLDER

# Calendly event-type URL for /extension-cleanup-review (per-funnel, not generic).
# Locked architecture rule: each funnel gets its own Calendly URL.
NEXT_PUBLIC_CALENDLY_URL_EXTENSION_CLEANUP=https://calendly.com/PLACEHOLDER/extension-cleanup-30min

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to skip GA loading.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to skip GTM loading.
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Site URL (used for canonical tags, OG, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.balancebeamteam.com
