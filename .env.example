# --- balancebeamteam.com landing page env ---

# Server-only. Real value provisioned in Vercel as GHL_LANDING_WEBHOOK_URL (no NEXT_PUBLIC_ prefix).
# Production value: GHL inbound webhook for the Extension Cleanup workflow (suffix 85b4e792).
GHL_LANDING_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/PLACEHOLDER

# Server-only (no NEXT_PUBLIC_). n8n production webhook + shared secret for IMP-233 Books Rescue.
BOOKS_RESCUE_N8N_WEBHOOK_URL=https://PLACEHOLDER/webhook/books-rescue-submit
BOOKS_RESCUE_N8N_WEBHOOK_SECRET=PLACEHOLDER

# Upstash Redis — dedicated instance for bbt-landing rate limiting (separate from any other project).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile — disabled by default. Flip TURNSTILE_ENABLED=true to engage without redeploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# Calendly event-type URL for /extension-cleanup-review (per-funnel, not generic).
# Locked architecture rule: each funnel gets its own Calendly URL.
NEXT_PUBLIC_CALENDLY_URL_EXTENSION_CLEANUP=https://calendly.com/PLACEHOLDER/extension-cleanup-30min

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to skip GA loading.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to skip GTM loading.
NEXT_PUBLIC_GTM_CONTAINER_ID=

# Site URL (used for canonical tags, OG, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.balancebeamteam.com
